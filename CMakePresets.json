{
    "version": 4,
    "cmakeMinimumRequired": {
        "major": 3,
        "minor": 20,
        "patch": 0
    },
    "configurePresets": [
        {
            "name": "base",
            "hidden": true,
            "binaryDir": "${sourceDir}/build/${presetName}",
            "cacheVariables": {
                "CMAKE_BUILD_TYPE": "Debug",
                "CMAKE_EXPORT_COMPILE_COMMANDS": "ON",
                "BUILD_TESTING": "OFF",
                "CMAKE_POLICY_VERSION_MINIMUM": "3.5"
            }
        },
        {
            "name": "windows-msvc",
            "displayName": "Windows (MSVC x64)",
            "inherits": "base",
            "generator": "Visual Studio 17 2022",
            "architecture": {
                "value": "x64",
                "strategy": "set"
            }
        },
        {
            "name": "windows-msvc-tests",
            "displayName": "Windows (MSVC x64, tests)",
            "inherits": "windows-msvc",
            "binaryDir": "${sourceDir}/build/${presetName}",
            "cacheVariables": {
                "BUILD_TESTING": "ON"
            }
        },
        {
            "name": "linux-gcc",
            "displayName": "Linux (GCC, Ninja)",
            "inherits": "base",
            "generator": "Ninja",
            "cacheVariables": {
                "CMAKE_C_COMPILER": "gcc",
                "CMAKE_CXX_COMPILER": "g++"
            }
        },
        {
            "name": "linux-clang",
            "displayName": "Linux (Clang, Ninja)",
            "inherits": "base",
            "generator": "Ninja",
            "cacheVariables": {
                "CMAKE_C_COMPILER": "clang",
                "CMAKE_CXX_COMPILER": "clang++"
            }
        },
        {
            "name": "macos-clang",
            "displayName": "macOS (Clang, Ninja)",
            "inherits": "base",
            "generator": "Ninja",
            "cacheVariables": {
                "CMAKE_C_COMPILER": "clang",
                "CMAKE_CXX_COMPILER": "clang++"
            }
        }
    ],
    "buildPresets": [
        {
            "name": "windows-msvc-debug",
            "displayName": "Windows Debug",
            "configurePreset": "windows-msvc",
            "configuration": "Debug"
        },
        {
            "name": "windows-msvc-release",
            "displayName": "Windows Release",
            "configurePreset": "windows-msvc",
            "configuration": "Release"
        },
        {
            "name": "windows-msvc-tests-debug",
            "displayName": "Windows Debug Tests",
            "configurePreset": "windows-msvc-tests",
            "configuration": "Debug"
        },
        {
            "name": "linux-gcc-build",
            "displayName": "Linux Build",
            "configurePreset": "linux-gcc",
            "configuration": "Debug"
        },
        {
            "name": "linux-clang-build",
            "displayName": "Linux Clang Build",
            "configurePreset": "linux-clang",
            "configuration": "Debug"
        },
        {
            "name": "macos-clang-build",
            "displayName": "macOS Build",
            "configurePreset": "macos-clang",
            "configuration": "Debug"
        }
    ],
    "testPresets": [
        {
            "name": "windows-msvc-project-tests",
            "displayName": "Windows Project Tests",
            "configurePreset": "windows-msvc-tests",
            "configuration": "Debug",
            "output": {
                "outputOnFailure": true
            },
            "filter": {
                "include": {
                    "name": "^(Packet|Executor|RoomManager|UserManager|ServerMusicFlow|LobbyScreenTest|RoomScreenTest)"
                }
            }
        }
    ]
}
